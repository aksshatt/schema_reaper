# Copy to .schema_reaper.yml and edit. Every key is optional.
---
# database_url: postgres://localhost/myapp_development   # else ENV["DATABASE_URL"]

# PostgreSQL schemas to scan. Tables outside public are reported as schema.table.
schemas:
  - public

# Hide findings below this confidence on every command (the CLI flag overrides).
min_confidence: 0.0

scan_paths:
  - app
  - lib
  - config

view_globs:
  - app/**/*.erb
  - app/**/*.haml
  - app/**/*.slim
  - app/**/*.jbuilder

ignore:
  tables:
    - schema_migrations
    - ar_internal_metadata
  columns:
    - "/_cache$/"        # wrap in slashes for a regex
    - legacy_notes

always_keep_columns:
  - id
  - created_at
  - updated_at
  - type

# Auto-whitelist columns owned by gems in your bundle (devise, paper_trail,
# activestorage, actiontext, friendly_id, audited, pg_search, ahoy_matey, ...).
gem_awareness: true

# Runtime usage log written by the tracker (see README > Runtime signal).
runtime_log: .schema_reaper/runtime.jsonl
# Rotate it to runtime.jsonl.1 past this many bytes; both are read. null: never.
runtime_log_max_bytes: 52428800

# Append-only snapshot log for `schema_reaper trend`.
history_log: .schema_reaper/history.jsonl

baseline: .schema_reaper/baseline.json

# Per-file cache of scan results; repeat scans re-parse only changed files.
scan_cache: .schema_reaper/scan_cache.json

# global: a column name anywhere in code counts as use on every table.
# model:  a name only in an app/models file counts for that model's table and
#         the tables it mentions. Stricter; review its findings before acting.
column_scope: global

# Extra Ruby files to load before analysis -- register custom analyzers here.
require: []
